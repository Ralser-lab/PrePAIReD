params {
  outdir = null
}

def OUT = (params.outdir && params.outdir.toString().trim())
  ? params.outdir.toString().trim()
  : launchDir.toString()

workDir = "${OUT}/work"

process {

    executor = 'local'
    maxForks = 1
    container = 'unified_env_all:1.0'
    echo = false
    errorStrategy = 'terminate'
    maxRetries = 1
    environment = [ 'TZ':'Europe/Berlin' ]
}


docker.enabled = true

report   { enabled = true; file = "${OUT}/nextflow_report.html"; overwrite = true }
timeline { enabled = true; file = "${OUT}/nextflow_timeline.html"; overwrite = true }
trace    { enabled = true; file = "${OUT}/nextflow_trace.txt"; overwrite = true
}
