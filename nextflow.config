params.outdir = params.outdir?.toString()?.trim() ?: launchDir.toString()

workDir = "${params.outdir}/work"

process {

    executor = 'local'
    maxForks = 1
    container = 'unified_env_all:1.0'
    echo = false
    errorStrategy = 'terminate'
    maxRetries = 1
    environment = [ 'TZ':'Europe/Berlin' ]
}


docker {
    enabled = true
}

report   { enabled = true; file = "${params.outdir}/nextflow_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/nextflow_timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/nextflow_trace.txt"; overwrite = true
}