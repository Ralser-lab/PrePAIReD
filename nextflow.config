// params.docker_memory = params.docker_memory ?: null // only if you want to enforce memory limit to docker uncomment... usually docker takes the memory it needs... the image on disk can take huge memory, but depending on the python/R code, the image can use 500mb or 80GB depending on what the script does!!! 

params.init_memory   = params.init_memory ?: '2 GB'
params.module_memory = params.module_memory ?: '8 GB'
params.init_cpus          = params.init_cpus ?: 1
params.module_cpus          = params.module_cpus ?: 4

params.outdir = params.outdir?.toString()?.trim() ?: launchDir.toString()

workDir = "${params.outdir}/work"

env {
    TZ = 'Europe/Berlin'
}

params.max_memory = params.max_memory ?: '8 GB'
params.memory_margin = params.memory_margin ?: '2 GB'

process {

    executor = 'local'
    maxForks = 1
    container = 'unified_env_all:1.0'
    errorStrategy = 'terminate'

    withName: INIT_PARAMS {
        cpus = params.init_cpus
        memory = {
            def base = params.init_memory.toString().replaceAll(/[^0-9.]/,'') as double
            def max  = params.max_memory.toString().replaceAll(/[^0-9.]/,'') as double
            def margin = params.memory_margin.toString().replaceAll(/[^0-9.]/,'') as double

            def safeMax = max - margin
            if (base >= safeMax)
                return "${safeMax} GB"

            def step = (safeMax - base) / 3
            def mem = base + step * (task.attempt - 1)
            def memRounded = Math.round(mem * 10) / 10

            return "${memRounded} GB"
        }
        errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: RUN_ALL_MODULES {
        cpus = params.module_cpus
        memory = {
            def base = params.module_memory.toString().replaceAll(/[^0-9.]/,'') as double
            def max  = params.max_memory.toString().replaceAll(/[^0-9.]/,'') as double
            def margin = params.memory_margin.toString().replaceAll(/[^0-9.]/,'') as double

            def safeMax = max - margin
            if (base >= safeMax)
                return "${safeMax} GB"

            def step = (safeMax - base) / 3
            def mem = base + step * (task.attempt - 1)
            def memRounded = Math.round(mem * 10) / 10

            return "${memRounded} GB"
        }
        errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
        errorStrategy = 'retry'
        maxRetries = 3
    }
}

docker {
    enabled = true
}

profiles {
    linux_docker_user {
        docker.runOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib"
    }
}

report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/nextflow_trace.txt"
    overwrite = true
}
// nextflow run nextflow.nf --memory '24 GB' --cpus 8
// nextflow run nextflow.nf -profile linux_docker_user
// nextflow run nextflow.nf --memory '24 GB' --cpus 8 --docker_memory 24g // use the --docker_memory if you want to force the limit, and so the corresponding lines above are uncommented
