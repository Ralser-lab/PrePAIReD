// params.docker_memory = params.docker_memory ?: null // only if we want to enforce memory limit to docker uncomment... usually docker takes the memory it needs... the image on disk can take huge memory, but depending on the python/R code, the image can use 500mb or 80GB depending on what the script does!!! 

/*
 * RESOURCES
 *
 *   --memory         first estimate of the memory per process (default 4 GB).
 *                    Units: '512 MB', '4 GB', '1.5 GB'; a plain number means GB.
 *   --cpus           CPUs for the modules (default 4). Capped at what Docker has.
 *   --max_memory     optional upper limit. Default: the memory Docker can use
 *                    (Docker Desktop: its "Memory limit" setting; Linux: the
 *                    machine's RAM) minus --memory_margin.
 *   --memory_margin  memory kept free for the system (default 2 GB).
 *
 * If a process is killed for lack of memory (exit 137/139/143), it is retried
 * up to 3 times; each retry moves the memory in equal steps from the first
 * estimate up to the limit, so the last attempt uses the maximum.
 *
 * Older options still work and override --memory / --cpus for one process:
 *   --init_memory, --module_memory, --init_cpus, --module_cpus
 */
params.memory        = params.memory ?: '4 GB'
params.cpus          = params.cpus ?: 4
params.max_memory    = params.max_memory ?: null
params.memory_margin = params.memory_margin ?: '2 GB'

params.init_memory   = params.init_memory ?: null
params.module_memory = params.module_memory ?: null
params.init_cpus     = params.init_cpus ?: 1
params.module_cpus   = params.module_cpus ?: null

params.outdir = params.outdir?.toString()?.trim() ?: launchDir.toString()

workDir = "${params.outdir}/work"

env {
    TZ = 'Europe/Berlin'
}

process {

    executor = 'local'
    maxForks = 1
    container = 'unified_env_all:1.0'
    errorStrategy = 'terminate'

    memory = {
        // Memory Docker can use (on a Mac: the Docker Desktop VM limit).
        def dockerMB = 0L
        try {
            def proc = ['docker', 'info', '--format', '{{.MemTotal}}'].execute()
            def out = proc.text.trim()
            proc.waitFor()
            if( out.isLong() ) {
                dockerMB = (out as long).intdiv(1048576)
            }
        }
        catch( Exception e ) {
            dockerMB = 0L
        }

        // Values to convert to megabytes: '4 GB', '512 MB', '1.5GB', '4' (= GB).
        // (Inline loop: the config syntax does not allow calling a local helper.)
        def isInit = task.process == 'INIT_PARAMS'
        def raw = [
            start : (isInit ? params.init_memory : params.module_memory) ?: params.memory,
            margin: params.memory_margin,
            max   : params.max_memory
        ]
        def mb = [:]
        raw.each { key, value ->
            if( value ) {
                def text = value.toString().trim().toUpperCase().replaceAll(/\s+/, '')
                def m = (text =~ /^([0-9]*\.?[0-9]+)([KMGT]?)B?$/)
                if( !m.matches() ) {
                    throw new IllegalArgumentException("Cannot read memory value '${value}'. Use e.g. '4 GB' or '512 MB'.")
                }
                def number = m.group(1) as double
                def unit = m.group(2)
                def factor = unit == 'K' ? 1.0 / 1024 : unit == 'M' ? 1.0 : unit == 'T' ? 1024.0 * 1024 : 1024.0
                mb[key] = Math.round(number * factor) as long
            }
        }

        def startMB = mb.start
        def marginMB = mb.margin ?: 0L

        // Upper limit: --max_memory if given, else Docker memory minus margin.
        // Never above what Docker itself can provide.
        def capMB = mb.max        ? mb.max
                  : dockerMB > 0  ? dockerMB - marginMB
                  : startMB
        if( dockerMB > 0 && capMB > dockerMB ) {
            capMB = dockerMB
        }
        if( capMB < 512 ) {
            capMB = Math.min(512L, dockerMB > 0 ? dockerMB : 512L)
        }
        if( startMB > capMB ) {
            startMB = capMB
        }

        // attempt 1 = first estimate ... attempt 4 (last retry) = limit
        def retries = 3
        def attemptMB = startMB + ((capMB - startMB) * Math.min(task.attempt - 1, retries)).intdiv(retries)
        return "${attemptMB} MB"
    }

    cpus = {
        def isInit = task.process == 'INIT_PARAMS'
        def requested = ((isInit ? params.init_cpus : params.module_cpus) ?: params.cpus) as int

        // Do not ask for more CPUs than Docker has.
        def dockerCpus = 0
        try {
            def proc = ['docker', 'info', '--format', '{{.NCPU}}'].execute()
            def out = proc.text.trim()
            proc.waitFor()
            if( out.isInteger() ) {
                dockerCpus = out as int
            }
        }
        catch( Exception e ) {
            dockerCpus = 0
        }

        return dockerCpus > 0 ? Math.max(1, Math.min(requested, dockerCpus)) : Math.max(1, requested)
    }

    withName: INIT_PARAMS {
        errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
    }

    withName: RUN_ALL_MODULES {
        errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
    }
}


// Parent of the output folder (falls back to the folder itself if it has no parent, e.g. '/').
params.docker_mount_root = new File(params.outdir).absoluteFile.parentFile?.absolutePath ?: new File(params.outdir).absolutePath

// Docker volume option, shell-quoted so paths with spaces (or apostrophes) work.
// runOptions is pasted unchanged into the "docker run ..." command line, so
// an unquoted path with a space would be split into several arguments.
// Single quotes keep the path as one argument; an apostrophe inside the path
// is written as '\'' (close quote, escaped apostrophe, reopen quote).
params.docker_volume = "'" +
    "${params.docker_mount_root}:${params.docker_mount_root}".replace("'", "'\\''") +
    "'"

docker {
    enabled = true
    runOptions = "-v ${params.docker_volume}"
}

profiles {
    linux_docker_user {
        docker.runOptions = "-v ${params.docker_volume} -u \$(id -u):\$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib"
    }
}
report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/nextflow_trace.txt"
    overwrite = true
}
// Examples:
// nextflow run nextflow.nf --memory '4 GB' --cpus 4
// nextflow run nextflow.nf --memory '1 GB' --cpus 1 --max_memory '12 GB'
// nextflow run nextflow.nf -profile linux_docker_user --memory '8 GB' --cpus 8
// To force a fixed limit for Docker itself, uncomment the params.docker_memory line at the top and pass --docker_memory 24g
